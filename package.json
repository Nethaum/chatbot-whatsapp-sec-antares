{
  "name": "chatbot-whatsapp-clube",
  "version": "1.7.10",
  "description": "Chatbot local e gratuito para WhatsApp Web, pensado para atendimento de clube.",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node src/index.js",
    "restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/restart-bot.ps1",
    "reset-session": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/reset-session.ps1",
    "stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-bot.ps1",
    "autostart:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-autostart.ps1",
    "autostart:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/status-autostart.ps1",
    "autostart:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/uninstall-autostart.ps1",
    "watchdog:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-watchdog.ps1",
    "watchdog:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/status-watchdog.ps1",
    "watchdog:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/uninstall-watchdog.ps1",
    "check-assets": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-assets.ps1",
    "members:update": "node scripts/update-members-cache.mjs",
    "members:find": "node scripts/find-member.mjs",
    "members:update:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-members-update-task.ps1",
    "members:update:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/status-members-update-task.ps1",
    "members:update:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/uninstall-members-update-task.ps1",
    "dev": "node --watch src/index.js",
    "check": "npm run check:syntax && npm run check:flows && npm run check:dates && npm run check:phones && npm run check:members && npm run check:guard && npm run check:groups && npm run check:internal-contacts && npm run check:direct-command",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:flows": "node scripts/test-fluxos.mjs",
    "check:dates": "node scripts/test-datas.mjs",
    "check:phones": "node scripts/test-telefones.mjs",
    "check:members": "node scripts/test-socios.mjs",
    "check:guard": "node scripts/test-duplicidade.mjs",
    "check:groups": "node scripts/test-grupos.mjs",
    "check:internal-contacts": "node scripts/test-contatos-internos.mjs",
    "check:direct-command": "node scripts/test-comando-direto.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.34.7"
  }
}
